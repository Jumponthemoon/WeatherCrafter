# Copy to `.env` and fill in your own values, then `source .env`
# (or export them in your shell). `.env` is gitignored -- never commit real keys.

# --- anchoring stage (first-frame weather edit) ---
# OpenAI API key -- GPT-4.1 scene parsing + prompt authoring.
OPENAI_API_KEY="sk-..."
# Black Forest Labs (FLUX.1 Kontext) API key -- repaints the first frame.
BFL_API_KEY="..."

# --- synthesis stage (VACE video editing) ---
# Runs in the current env by default (install with: pip install -e ".[synthesis]").
# Set this ONLY if you keep VACE in a separate conda env:
# WEATHERCRAFTER_VACE_ENV="vace"

# All three below are optional. See "VACE runtime knobs" in README.md.
# Set if synthesis OOMs: cap GPU residency (GB) and spill the rest to CPU.
# 36 works on a 48 GB card; lower it for tighter cards.
# WEATHERCRAFTER_VACE_VRAM_LIMIT_GB=36
# Set if the run hangs before generating: resolve cached weights by local path
# instead of querying the ModelScope hub. Needs one successful online run first.
# WEATHERCRAFTER_VACE_OFFLINE=1
# Where cached weights live / offline mode searches (default ./models, ~30 GB).
# WEATHERCRAFTER_MODELS_DIR="./models"
